{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://smh.ynz.temporary.site/api/:path*"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "pos.fiscalpoint.com.do" }],
      "destination": "/pos.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
